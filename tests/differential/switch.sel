ritual label(int x) -> int {
    wax int r = 0;
    switch (x) {
        case 1: {
            r = 10;
            break;
        };
        case 2: {
            r = 20;
            break;
        };
        default: {
            r = 99;
            break;
        };
    };
    return r;
};
whisper label(1);
whisper label(2);
whisper label(7);
