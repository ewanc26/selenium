// Generated by scripts/gen_donut_engine.py: a live spinning torus
// streaming F/P/S tokens to host/donut_host.c (SDL2).
// Run: ./build/seleniumc examples/donut_engine.sel --run --cc clang
//          | ./build/donut_host --frames 3   (SDL_VIDEODRIVER=dummy works)
wax float cb = 0.751805729141;
wax float sb = 0.659384671971;
wax float thstep = 0.392699081699;
wax float phstep = 0.628318530718;
wax float ca = 0.0;
wax float sa = 0.0;
wax float ct1 = 0.0;
wax float st1 = 0.0;
wax float ct2 = 0.0;
wax float st2 = 0.0;
wax float cp1 = 0.0;
wax float sp1 = 0.0;
wax float cp2 = 0.0;
wax float sp2 = 0.0;
wax float nx = 0.0;
wax float ny = 0.0;
wax float nz = 0.0;
wax float lum = 0.0;
wax float cr = 0.0;
wax float cg = 0.0;
wax float colb = 0.0;
wax float rad = 0.0;
wax float x = 0.0;
wax float y = 0.0;
wax float z = 0.0;
wax float cy = 0.0;
wax float cz = 0.0;
orbit (wax int f = 0; f < 40; f = f + 1) {
    ca = cos(0.05 * f);
    sa = sin(0.05 * f);
    whisper "F";
    orbit (wax int i = 0; i < 16; i = i + 1) {
        ct1 = cos(i * thstep);
        st1 = sin(i * thstep);
        ct2 = cos((i + 1) * thstep);
        st2 = sin((i + 1) * thstep);
        orbit (wax int j = 0; j < 10; j = j + 1) {
            cp1 = cos(j * phstep);
            sp1 = sin(j * phstep);
            cp2 = cos((j + 1) * phstep);
            sp2 = sin((j + 1) * phstep);
            ny = sp1 * ca - cp1 * st1 * sa;
            nz = sp1 * sa + cp1 * st1 * ca;
            nx = cp1 * ct1 * cb + nz * sb;
            lum = (nx * 0.32 + ny * 0.58 + nz * 0.75 + 1.0) * 0.5;
            cr = 150.0 * lum + 80.0;
            cg = 90.0 * lum + 50.0;
            colb = 60.0 * lum + 30.0;
            whisper "P";
            rad = 3.0 + 1.25 * cp1;
            x = rad * ct1;
            y = 1.25 * sp1;
            z = rad * st1;
            cy = y * ca - z * sa;
            cz = y * sa + z * ca;
            whisper (x * cb + cz * sb) * 28.0 + 120.0;
            whisper 120.0 - cy * 28.0;
            rad = 3.0 + 1.25 * cp2;
            x = rad * ct1;
            y = 1.25 * sp2;
            z = rad * st1;
            cy = y * ca - z * sa;
            cz = y * sa + z * ca;
            whisper (x * cb + cz * sb) * 28.0 + 120.0;
            whisper 120.0 - cy * 28.0;
            rad = 3.0 + 1.25 * cp2;
            x = rad * ct2;
            y = 1.25 * sp2;
            z = rad * st2;
            cy = y * ca - z * sa;
            cz = y * sa + z * ca;
            whisper (x * cb + cz * sb) * 28.0 + 120.0;
            whisper 120.0 - cy * 28.0;
            rad = 3.0 + 1.25 * cp1;
            x = rad * ct2;
            y = 1.25 * sp1;
            z = rad * st2;
            cy = y * ca - z * sa;
            cz = y * sa + z * ca;
            whisper (x * cb + cz * sb) * 28.0 + 120.0;
            whisper 120.0 - cy * 28.0;
            whisper cr;
            whisper cg;
            whisper colb;
        };
    };
    whisper "S";
};
