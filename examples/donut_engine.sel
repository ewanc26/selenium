// Generated by scripts/gen_donut_engine.py: a live orbiting-light torus
// streaming per-frame vertex lists to host/donut_host.c (SDL2),
// protocol v2: F, 1500 x (px py z intensity) as %g, S.
summon ritual donut_num(float v) -> int from "donut_num.c";
summon ritual sqrt(float v) -> float;
wax float cax = 0.0;
wax float sax = 0.0;
wax float cay = 0.0;
wax float say = 0.0;
wax float caz = 0.0;
wax float saz = 0.0;
wax float lx = 0.0;
wax float ly = 0.0;
wax float lz = 0.0;
wax float u = 0.0;
wax float cu = 0.0;
wax float su = 0.0;
wax float v = 0.0;
wax float cv = 0.0;
wax float sv = 0.0;
wax float vx = 0.0;
wax float vy = 0.0;
wax float vz = 0.0;
wax float nx0 = 0.0;
wax float ny0 = 0.0;
wax float nz0 = 0.0;
wax float p1x = 0.0;
wax float p1y = 0.0;
wax float p1z = 0.0;
wax float p2x = 0.0;
wax float p2y = 0.0;
wax float p2z = 0.0;
wax float rpx = 0.0;
wax float rpy = 0.0;
wax float rpz = 0.0;
wax float n1x = 0.0;
wax float n1y = 0.0;
wax float n1z = 0.0;
wax float n2x = 0.0;
wax float n2y = 0.0;
wax float n2z = 0.0;
wax float rnx = 0.0;
wax float rny = 0.0;
wax float rnz = 0.0;
wax float ldx = 0.0;
wax float ldy = 0.0;
wax float ldz = 0.0;
wax float dist = 0.0;
wax float inten = 0.0;
wax float camz = 0.0;
wax float px = 0.0;
wax float py = 0.0;
wax float az = 0.0;
wax float la = 0.0;
cax = 0.87758256189;
sax = 0.479425538604;
cay = 0.87758256189;
say = 0.479425538604;
orbit (wax int f = 0; f < 48; f = f + 1) {
    la = la + 0.025;
    lx = cos(la) * 4.5;
    ly = sin(la) * 4.5;
    lz = sin(la * 0.7) * 2.5;
    caz = cos(az);
    saz = sin(az);
    whisper "F";
    orbit (wax int i = 0; i < 50; i = i + 1) {
        u = i * 0.125663706144;
        cu = cos(u);
        su = sin(u);
        orbit (wax int j = 0; j < 30; j = j + 1) {
            v = j * 0.209439510239;
            cv = cos(v);
            sv = sin(v);
            vx = (2.0 + 0.8 * cv) * cu;
            vy = (2.0 + 0.8 * cv) * su;
            vz = 0.8 * sv;
            nx0 = cv * cu;
            ny0 = cv * su;
            nz0 = sv;
            p1y = vy * cax - vz * sax;
            p1z = vy * sax + vz * cax;
            p1x = vx;
            p2x = p1x * cay + p1z * say;
            p2z = -p1x * say + p1z * cay;
            p2y = p1y;
            rpx = p2x * caz - p2y * saz;
            rpy = p2x * saz + p2y * caz;
            rpz = p2z;
            n1y = ny0 * cax - nz0 * sax;
            n1z = ny0 * sax + nz0 * cax;
            n1x = nx0;
            n2x = n1x * cay + n1z * say;
            n2z = -n1x * say + n1z * cay;
            n2y = n1y;
            rnx = n2x * caz - n2y * saz;
            rny = n2x * saz + n2y * caz;
            rnz = n2z;
            ldx = lx - rpx;
            ldy = ly - rpy;
            ldz = lz - rpz;
            dist = sqrt(ldx * ldx + ldy * ldy + ldz * ldz);
            eclipse (dist > 1e-10) {
                ldx = ldx / dist;
                ldy = ldy / dist;
                ldz = ldz / dist;
            };
            inten = rnx * ldx + rny * ldy + rnz * ldz;
            eclipse (inten < 0.08) {
                inten = 0.08;
            };
            inten = inten / (1.0 + 0.04 * dist);
            camz = rpz + 5.0;
            px = (rpx / camz) * 500.0 + 400.0;
            py = (rpy / camz) * 500.0 + 300.0;
            donut_num(px);
            donut_num(py);
            donut_num(camz);
            donut_num(inten);
        };
    };
    whisper "S";
    az = az + 0.003;
};
