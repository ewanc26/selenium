// Generated by scripts/gen_donut_engine.py: a live orbiting-light torus
// streaming per-frame vertex lists to host/donut_host.c (SDL2),
// protocol v2: F, 1500 x (px py z intensity) as %g, S.
// Mirrors doughnut.c's float32 pipeline: every variable and constant is
// a C float (per-operation single-precision folds) and trig/sqrt are the
// C cosf/sinf/sqrtf, exactly like the reference.
summon ritual donut_num(float v) -> int from "donut_num.c";
summon ritual cosf(single v) -> single;
summon ritual sinf(single v) -> single;
summon ritual sqrtf(single v) -> single;
wax single k2 = 2.0;
wax single k08 = 0.8;
wax single k50 = 50.0;
wax single k30 = 30.0;
wax single k025 = 0.025;
wax single k003 = 0.003;
wax single k07 = 0.7;
wax single k45 = 4.5;
wax single k25 = 2.5;
wax single k08f = 0.08;
wax single k004 = 0.04;
wax single k1 = 1.0;
wax single ke5 = 1e-5;
wax single k5 = 5.0;
wax single kfov = 500.0;
wax single k400 = 400.0;
wax single k300 = 300.0;
wax single k05 = 0.5;
wax double dpi = 3.141592653589793;
wax single cax = 0.0;
wax single sax = 0.0;
wax single cay = 0.0;
wax single say = 0.0;
wax single caz = 0.0;
wax single saz = 0.0;
wax single lx = 0.0;
wax single ly = 0.0;
wax single lz = 0.0;
wax single u = 0.0;
wax single cu = 0.0;
wax single su = 0.0;
wax single v = 0.0;
wax single cv = 0.0;
wax single sv = 0.0;
wax single vx = 0.0;
wax single vy = 0.0;
wax single vz = 0.0;
wax single nx0 = 0.0;
wax single ny0 = 0.0;
wax single nz0 = 0.0;
wax single p1x = 0.0;
wax single p1y = 0.0;
wax single p1z = 0.0;
wax single p2x = 0.0;
wax single p2y = 0.0;
wax single p2z = 0.0;
wax single rpx = 0.0;
wax single rpy = 0.0;
wax single rpz = 0.0;
wax single n1x = 0.0;
wax single n1y = 0.0;
wax single n1z = 0.0;
wax single n2x = 0.0;
wax single n2y = 0.0;
wax single n2z = 0.0;
wax single rnx = 0.0;
wax single rny = 0.0;
wax single rnz = 0.0;
wax single ldx = 0.0;
wax single ldy = 0.0;
wax single ldz = 0.0;
wax single dist = 0.0;
wax single inten = 0.0;
wax single camz = 0.0;
wax single px = 0.0;
wax single py = 0.0;
wax single az = 0.0;
wax single la = 0.0;
orbit (wax int f = 0; f < 48; f = f + 1) {
    la = la + k025;
    lx = cosf(la) * k45;
    ly = sinf(la) * k45;
    lz = sinf(la * k07) * k25;
    caz = cosf(az);
    saz = sinf(az);
    whisper "F";
    orbit (wax int i = 0; i < 50; i = i + 1) {
        u = i / k50 * k2 * dpi;
        cu = cosf(u);
        su = sinf(u);
    orbit (wax int j = 0; j < 30; j = j + 1) {
            v = j / k30 * k2 * dpi;
            cv = cosf(v);
            sv = sinf(v);
            vx = (k2 + k08 * cv) * cu;
            vy = (k2 + k08 * cv) * su;
            vz = k08 * sv;
            nx0 = cv * cu;
            ny0 = cv * su;
            nz0 = sv;
            p1y = vy * cosf(k05) - vz * sinf(k05);
            p1z = vy * sinf(k05) + vz * cosf(k05);
            p1x = vx;
            p2x = p1x * cosf(k05) + p1z * sinf(k05);
            p2z = p1z * cosf(k05) - p1x * sinf(k05);
            p2y = p1y;
            rpx = p2x * caz - p2y * saz;
            rpy = p2x * saz + p2y * caz;
            rpz = p2z;
            n1y = ny0 * cosf(k05) - nz0 * sinf(k05);
            n1z = ny0 * sinf(k05) + nz0 * cosf(k05);
            n1x = nx0;
            n2x = n1x * cosf(k05) + n1z * sinf(k05);
            n2z = n1z * cosf(k05) - n1x * sinf(k05);
            rnx = n2x * caz - n1y * saz;
            rny = n2x * saz + n1y * caz;
            rnz = n2z;
            ldx = lx - rpx;
            ldy = ly - rpy;
            ldz = lz - rpz;
            dist = sqrtf(ldx * ldx + ldy * ldy + ldz * ldz);
            eclipse (dist > ke5) {
                ldx = ldx / dist;
                ldy = ldy / dist;
                ldz = ldz / dist;
            };
            inten = rnx * ldx + rny * ldy + rnz * ldz;
            eclipse (inten < k08f) {
                inten = k08f;
            };
            inten = inten / (k1 + k004 * dist);
            camz = rpz + k5;
            px = (rpx / camz) * kfov + k400;
            py = (rpy / camz) * kfov + k300;
            donut_num(px);
            donut_num(py);
            donut_num(camz);
            donut_num(inten);
        };
    };
    whisper "S";
    az = az + k003;
};
