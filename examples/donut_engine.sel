            nx = cp1 * ct1 * cb + nz * sb;
            lum = (nx * 0.32 + ny * 0.58 + nz * 0.75 + 1.0) * 0.5;
            cr = lum * 150.0 + 80.0;
            cg = lum * 90.0 + 50.0;
            colb = lum * 60.0 + 30.0;
            whisper "P";
            rad = cp1 * 1.25 + 3.0;
            x = rad * ct1;
            y = sp1 * 1.25;
            z = rad * st1;
            cy = y * ca - z * sa;
            cz = y * sa + z * ca;
            donut_num((x * cb + cz * sb) * 28.0 + 120.0);
            donut_num(120.0 - cy * 28.0);
            rad = cp2 * 1.25 + 3.0;
